MODEL_PROVIDER=demo

# OpenAI-compatible providers.
# Keep MODEL_API_KEY server-side only. Do not expose it to the browser.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=
MODEL_THINKING=disabled

# Request budgets
MODEL_TIMEOUT_MS=45000
KNOWLEDGE_MAX_CHUNKS=5
KNOWLEDGE_MAX_CHARS=12000
# Optional when the deployed app cannot discover the repository root.
# For this repository, the default local value resolves from apps/web to ../../.
KNOWLEDGE_WORKSPACE_ROOT=
# Optional self-hosted RSSHub base URL, e.g. https://rsshub.example.com
# Public rsshub.app is for testing and may restrict production usage.
RSSHUB_BASE_URL=
# Optional TopHub config. TOPHUB_NODE_PATHS accepts comma-separated paths like /n/xxxx,/n/yyyy.
TOPHUB_BASE_URL=https://tophub.today
TOPHUB_NODE_PATHS=
